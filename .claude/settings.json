{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/tsc.js",
            "statusMessage": "Validating TypeScript...",
            "timeout": 60,
            "asyncRewake": true
          }
        ]
      }
    ]
  }
}
